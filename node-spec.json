      "required": [
        "trigger_mode"
      ],
      "fields": [
        {
          "name": "trigger_mode",
          "type": "enum",
          "tip": "trigger.trigger_mode"
        },
        {
          "name": "schedule",
          "type": "cron",
          "tip": "trigger.schedule"
        }
      ],
      "tips": []
    },
